{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev:backend": "php artisan serve",
        "dev:frontend": "cd frontend && npm run dev",
        "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue,teal\" \"npm run dev:backend\" \"npm run dev:frontend\"",
        "build": "vite build"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    }
}
