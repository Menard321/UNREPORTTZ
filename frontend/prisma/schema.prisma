// Prisma Schema for ReportWise University Profiles and Dynamic Covers (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institution {
  id          String               @id @default(cuid())
  name        String
  shortName   String
  type        String               // university | college | institute
  country     String               @default("Tanzania")
  logoFile    String?
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  units       AcademicUnit[]
  profiles    InstitutionProfile[]
  reports     Report[]
}

model AcademicUnit {
  id            String        @id @default(cuid())
  institutionId String
  name          String
  shortName     String?
  kind          String        // college | school | faculty | business_school | institute
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  departments   Department[]
  programmes    Programme[]
  reports       Report[]
}

model Department {
  id          String        @id @default(cuid())
  unitId      String
  name        String        // stored WITHOUT the word "Department"
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  unit        AcademicUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  programmes  Programme[]
  reports     Report[]
}

model Programme {
  id                String        @id @default(cuid())
  unitId            String
  departmentId      String?
  name              String        // stored in full e.g. "Bachelor of Commerce in Accounting"
  level             String        // certificate | diploma | bachelor | masters
  durationYears     Int?          @default(3)
  needsVerification Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  unit              AcademicUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  department        Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  reports           Report[]
}

model InstitutionProfile {
  id                 String           @id @default(cuid())
  institutionId      String
  slug               String           @unique
  matching           Json             // JSON object
  reportTypeKey      String
  labels             Json             // JSON object: { reportName, photoLabel, figureListTitle, abbreviationsTitle }
  cover              Json             // JSON object: { lines, border, labelStyle }
  frontMatter        Json             // JSON array
  chapters           Json             // JSON array
  references         Json             // JSON object
  appendices         Json             // JSON array
  formatting         Json             // JSON object
  source             Json             // JSON object
  verificationStatus String           // official_guideline | department_template | student_sample | verified
  verificationNote   String?
  verifiedOn         DateTime?
  version            Int              @default(1)
  isActive           Boolean          @default(true)
  rawJson            Json             // Original JSON blob
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  institution        Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  sections           ProfileSection[]
  reports            Report[]
}

model ProfileSection {
  id           String             @id @default(cuid())
  profileId    String
  chapterIndex Int
  order        Int
  number       String?
  title        String
  kind         String
  required     Boolean            @default(true)
  questionKeys Json               // JSON array of keys
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  profile      InstitutionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Report {
  id                   String              @id @default(cuid())
  title                String
  institutionId        String
  unitId               String?
  departmentId         String?
  programmeId          String?
  profileId            String
  profileVersion       Int
  reportContext        Json                // JSON object
  coverSnapshot        Json                // JSON object
  overrides            Json?               // JSON object
  universityNameCustom String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  institution          Institution         @relation(fields: [institutionId], references: [id])
  unit                 AcademicUnit?       @relation(fields: [unitId], references: [id])
  department           Department?         @relation(fields: [departmentId], references: [id])
  programme            Programme?          @relation(fields: [programmeId], references: [id])
  profile              InstitutionProfile  @relation(fields: [profileId], references: [id])
}
